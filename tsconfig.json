{
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "temporal-polyfill/global"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "prisma.config.ts"]
}
