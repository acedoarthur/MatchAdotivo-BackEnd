// use prisma-8

model Instituicao {
  id_instituicao Int @id @default(autoincrement())
  cnpj VarChar(14) @unique
  razao_social VarChar(200)
  endereco VarChar(255)
  foto VarChar(500)?
  animais Animal[]
  usuario Usuario?

  @@map("instituicoes")
}

model Animal {
  id_animal Int @id @default(autoincrement())
  raca VarChar(100)?
  tipo VarChar(50)
  data_nascimento DateString?
  detalhes String?
  foto VarChar(500)?
  apelido VarChar(100)?
  id_instituicao Int
  instituicao Instituicao @relation(fields: [id_instituicao], references: [id_instituicao], onDelete: Restrict)
  vacinacoes AnimalVacina[]
  matches Match[]

  @@map("animais")
}

model Vacina {
  id_vacina Int @id @default(autoincrement())
  nome VarChar(150)
  aplicacoes AnimalVacina[]

  @@map("vacinas")
}

model AnimalVacina {
  id_animal_vacina Int @id @default(autoincrement())
  id_animal Int
  id_vacina Int
  data_aplicacao DateString
  animal Animal @relation(fields: [id_animal], references: [id_animal], onDelete: Restrict)
  vacina Vacina @relation(fields: [id_vacina], references: [id_vacina], onDelete: Restrict)

  @@map("animais_vacinas")
}

model Adotante {
  id_adotante Int @id @default(autoincrement())
  cpf VarChar(11) @unique
  nome VarChar(200)
  endereco VarChar(255)
  tipo_residencia VarChar(30)
  data_nascimento DateTime?
  possui_animais Boolean
  quantidade_animais Int
  tipos_animais String?
  matches Match[]
  usuario Usuario?

  @@check(expression: "quantidade_animais >= 0 AND ((possui_animais = false AND quantidade_animais = 0) OR (possui_animais = true AND quantidade_animais > 0))", name: "adotante_quantidade_coerente")
  @@check(expression: "tipo_residencia IN ('CASA', 'APARTAMENTO', 'CHÁCARA', 'OUTRO')", name: "adotante_residencia_valida")
  @@map("adotantes")
}

model Match {
  id_match Int @id @default(autoincrement())
  id_adotante Int
  id_animal Int
  data_pedido DateTime @default(now())
  status VarChar(20) @default("PENDENTE")
  adotante Adotante @relation(fields: [id_adotante], references: [id_adotante], onDelete: Restrict)
  animal Animal @relation(fields: [id_animal], references: [id_animal], onDelete: Restrict)

  @@check(expression: "status IN ('PENDENTE', 'EM ANDAMENTO', 'APROVADO', 'CANCELADO')", name: "match_status_valido")
  @@index([id_animal], unique: true, where: "status = 'APROVADO'", name: "match_aprovado_unico")
  @@map("matches")
}

model Usuario {
  id_usuario Int @id @default(autoincrement())
  nome VarChar(200)
  email VarChar(255) @unique
  senha VarChar(100)
  created_at DateTime @default(now())
  // Perfil da conta. ADOTANTE e INSTITUICAO apontam para o próprio cadastro; ADMIN não tem vínculo e só é
  // atribuído pelo comando de servidor. Contas anteriores aos perfis ficam com perfil null (sem permissões).
  perfil VarChar(20)?
  id_adotante Int? @unique
  id_instituicao Int? @unique
  adotante Adotante? @relation(fields: [id_adotante], references: [id_adotante], onDelete: Restrict)
  instituicao Instituicao? @relation(fields: [id_instituicao], references: [id_instituicao], onDelete: Restrict)

  @@check(expression: "(perfil IS NULL AND id_adotante IS NULL AND id_instituicao IS NULL) OR (perfil = 'ADOTANTE' AND id_adotante IS NOT NULL AND id_instituicao IS NULL) OR (perfil = 'INSTITUICAO' AND id_instituicao IS NOT NULL AND id_adotante IS NULL) OR (perfil = 'ADMIN' AND id_adotante IS NULL AND id_instituicao IS NULL)", name: "usuario_perfil_coerente")
  @@map("usuarios")
}
