# Credenciais apenas para o ambiente local deste laboratório.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=match_local
POSTGRES_DB=match_adotivo
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:match_local@localhost:5433/match_adotivo
TEST_DATABASE_URL=postgresql://postgres:match_local@localhost:5434/match_adotivo_test
PORT=3001

# Segredo de assinatura dos tokens JWT. Gere um valor próprio para cada ambiente com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
